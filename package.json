{
  "name": "jaago-hub",
  "version": "2.2.0",
  "private": true,
  "main": "index.js",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*",
    "packages/modules/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "start:server": "node index.js",
    "build": "turbo run build && node tooling/scripts/prepare-deploy.mjs",
    "deploy:prepare": "node tooling/scripts/prepare-deploy.mjs",
    "dev": "turbo run dev --parallel",
    "dev:web": "npm run dev --workspace=@jaago/web",
    "dev:worker": "npm run dev --workspace=@jaago/worker",
    "dev:log-runner": "npm run dev --workspace=@jaago/log-runner",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "jaago": "tsx tooling/scripts/jaago-cli.ts",
    "smoke-test": "tsx tooling/scripts/smoke-test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2"
  }
}
