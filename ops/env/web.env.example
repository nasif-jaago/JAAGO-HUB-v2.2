# JAAGO HUB v2.2 — Web Service Environment Configuration
# File Path on Host: /etc/jaago-hub/web.env (Permissions: 0600 jaago:jaago)

NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Database Configuration
DATABASE_URL=postgresql://jaago_app:P0stgr3s_Secur3_2026@127.0.0.1:5432/jaago_hub_prod?sslmode=prefer
DATABASE_POOL_MIN=4
DATABASE_POOL_MAX=20

# Redis & Cache Configuration
REDIS_URL=redis://127.0.0.1:6379/0

# JWT & Authentication Secrets
JWT_SECRET=jaago_jwt_super_secret_signing_key_production_2026_minimum_32_chars!
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Vault Encryption Key (32-byte hex for AES-256-GCM)
VAULT_MASTER_KEY=e4f91b72a089c2567890123456789abcdef0123456789abcdef0123456789abcdef0

# Storage & S3 Signed URL Secret (HMAC SHA-256)
STORAGE_HMAC_SECRET=jaago_storage_signing_hmac_secret_2026_super_secure!
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/var/jaago/storage

# Google Drive Cloud Sync
GOOGLE_DRIVE_BACKUP_FOLDER_ID=1a2b3c4d5e6f7g8h9i0j_jaago_backups
