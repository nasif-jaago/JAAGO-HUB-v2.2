# JAAGO HUB v2.2 — Log Runner Spool Uploader Environment Configuration
# File Path on Host: /etc/jaago-hub/log-runner.env (Permissions: 0600 jaago:jaago)

NODE_ENV=production

# Spool Buffer Configuration
SPOOL_DIRECTORY=/var/jaago/spool
SPOOL_SAFETY_CAP_MB=500
SPOOL_FLUSH_INTERVAL_MS=5000
SPOOL_BATCH_SIZE=100

# Database Direct Insertion
DATABASE_URL=postgresql://jaago_app:P0stgr3s_Secur3_2026@127.0.0.1:5432/jaago_hub_prod?sslmode=prefer

# Gzip Compression
ENABLE_GZIP_COMPRESSION=true
