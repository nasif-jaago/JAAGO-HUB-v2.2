# =================================================================
# JAAGO HUB v2.2 — Master Environment Configuration Template
# =================================================================

# ── APPLICATION ──
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Dhaka
APP_CURRENCY=BDT
APP_SECRET=replace_with_at_least_32_chars_random_secret_string

# ── PRIMARY TRANSACTIONAL DATABASE (Supabase / Postgres) ──
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── SUPABASE AUTH & STORAGE (Primary) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-primary-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── REDIS 7 (Cache, Queues, Distributed Locks) ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# ── AUTH & SECURITY ──
AUTH_SESSION_EXPIRY_SECONDS=604800
AUTH_MFA_ENFORCED=false
# 32-byte (64 hex chars) master key for AES-256-GCM authenticated encryption
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CORS_ALLOWED_ORIGINS=https://jaagohub.jaago.com.bd,https://jaagocore.jaago.com.bd
RATE_LIMIT_ENABLED=true

# ── LOGGING & LOCAL SPOOL BUFFER ──
LOG_LEVEL=info
LOG_SPOOL_DIR=/var/lib/jaago-hub/log-spool
LOG_SPOOL_MAX_TOTAL_BYTES=1073741824
LOG_SPOOL_ROTATE_MAX_BYTES=33554432
LOG_SPOOL_ROTATE_MAX_SECONDS=900

# ── SEPARATE LOGGER SUPABASE (Req 59) ──
LOGGER_DATABASE_URL=postgresql://postgres.loggerproject:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
LOGGER_SUPABASE_URL=https://your-logger-project.supabase.co
LOGGER_SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── GOOGLE OAUTH & GOOGLE DRIVE BACKUP ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_ENCRYPTED_REFRESH_TOKEN=

# ── EMAIL (SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="JAAGO HUB <no-reply@jaago.com.bd>"
EMAIL_PROVIDER=smtp

# ── GITHUB & MCP ──
GITHUB_READ_ONLY_TOKEN=
GITHUB_REPO_OWNER=jaago-foundation
GITHUB_REPO_NAME=jaago-hub

# ── STORAGE ──
STORAGE_PROVIDER=supabase
STORAGE_BUCKET_PRIVATE=jaago-private-docs
STORAGE_BUCKET_PUBLIC=jaago-public-assets
STORAGE_MAX_FILE_SIZE_BYTES=26214400

# ── AI LOG ANALYSIS (Req 67, Disabled by default) ──
AI_LOG_ANALYSIS_ENABLED=false
GEMINI_API_KEY=
