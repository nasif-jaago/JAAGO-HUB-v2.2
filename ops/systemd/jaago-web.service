[Unit]
Description=JAAGO HUB Web Service (Next.js)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=jaago
Group=jaago
WorkingDirectory=/var/www/jaago-hub
EnvironmentFile=/etc/jaago-hub/web.env
ExecStart=/usr/bin/npm run start --workspace=@jaago/web
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
