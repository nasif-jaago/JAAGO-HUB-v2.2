[Unit]
Description=JAAGO HUB Log Spool Uploader Runner
After=network.target

[Service]
Type=simple
User=jaago
Group=jaago
WorkingDirectory=/var/www/jaago-hub
EnvironmentFile=/etc/jaago-hub/log-runner.env
ExecStart=/usr/bin/pnpm --filter @jaago/log-runner start
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
